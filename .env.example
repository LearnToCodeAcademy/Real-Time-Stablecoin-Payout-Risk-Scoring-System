ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_API_KEY_V0=your_etherscan_api_key_here
ETHERSCAN_API_KEY_V1=your_etherscan_api_key_here
ETHERSCAN_API_KEY_V2=your_etherscan_api_key_here
ETHERSCAN_API_KEY_V3=your_etherscan_api_key_here
ETHERSCAN_API_KEY_V4=your_etherscan_api_key_here
DATABASE_URL=your_postgres_connection_string_here
ALCHEMY_WS_URL=wss://your-provider-websocket-url-here
INFURA_WS_URL=wss://your-provider-websocket-url-here
ETH_RPC_WS_URL=wss://your-provider-websocket-url-here
STREAM_ALERT_THRESHOLD=0.75
ETHERSCAN_CALLS_PER_SECOND_PER_KEY=2.5
ETHERSCAN_LIVE_POLL_SECONDS=3
LIVE_MAX_EVENTS_PER_BLOCK=50
LIVE_SCORE_MAX_PER_BLOCK=2
ENABLE_LOCAL_TRAINING=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_KEYS_SHA256=comma_separated_sha256_hashes_for_future_api_auth
REQUIRE_API_AUTH=false
API_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOCALHOST=false
SCORE_CACHE_TTL_SECONDS=120
REDIS_URL=redis://localhost:6379/0
ENABLE_ETHERSCAN_METADATA=false
ENABLE_EXPLORER_REPUTATION=false
THREAT_INTEL_CHAIN_IDS=1,137
THREAT_INTEL_FILES=
THREAT_INTEL_CACHE_TTL_SECONDS=900
THREAT_INTEL_TIMEOUT_SECONDS=8
CHAINABUSE_API_USERNAME=
CHAINABUSE_API_PASSWORD=
